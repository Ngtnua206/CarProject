@page "{id:int}"
@model CarProject.Pages.Orders.DepositFormModel

@{
    ViewData["Title"] = "Đặt cọc xe";
}

<div class="deposit-page">
    <div class="container py-4">
        <nav class="breadcrumb-premium mb-4">
            <a asp-page="/Index"><i class="fas fa-home"></i> Trang chủ</a>
            <span>/</span>
            <a asp-page="/Cars">Showroom</a>
            <span>/</span>
            <a asp-page="/Details" asp-route-id="@Model.PhienBan?.MaDong">Chi tiết</a>
            <span>/</span>
            <span>Đặt cọc</span>
        </nav>

        @if (Model.PhienBan == null)
        {
            <div class="text-center py-5">
                <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.2;"><i class="fas fa-exclamation-triangle"></i></div>
                <h4 style="color: var(--brand-white);">Không tìm thấy phiên bản xe</h4>
                <a asp-page="/Index" class="btn-premium btn-premium-solid mt-3 d-inline-flex"><i class="fas fa-arrow-left"></i> Quay lại</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="deposit-card">
                        <div style="background: var(--brand-black); padding: 2rem; text-align: center;">
                            <i class="fas fa-car" style="font-size: 3rem; opacity: 0.15; color: var(--brand-white);"></i>
                        </div>
                        <div style="padding: 1.5rem 0 0;">
                            <h4>@Model.PhienBan.TenPhienBan</h4>
                            <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem;">
                                <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.82rem;">
                                    <span style="color: var(--text-muted);">Dòng xe</span>
                                    <span style="font-weight: 600; color: var(--brand-white);">@Model.PhienBan.DongXe?.TenDong</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.82rem;">
                                    <span style="color: var(--text-muted);">Màu sắc</span>
                                    <span style="font-weight: 600; color: var(--brand-white);">@Model.PhienBan.MauSac</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.82rem;">
                                    <span style="color: var(--text-muted);">Động cơ</span>
                                    <span style="font-weight: 600; color: var(--brand-white);">@Model.PhienBan.DongCo</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; font-size: 0.82rem;">
                                    <span style="color: var(--text-muted);">Hộp số</span>
                                    <span style="font-weight: 600; color: var(--brand-white);">@Model.PhienBan.HopSo</span>
                                </div>
                            </div>
                            <div style="font-family: var(--font-title); font-size: 1.5rem; font-weight: 700; color: var(--brand-white);">
                                @{
                                    var price = Model.PhienBan.GiaNiemYet >= 1_000_000_000
                                        ? $"{Model.PhienBan.GiaNiemYet / 1_000_000_000:N1} tỷ"
                                        : $"{Model.PhienBan.GiaNiemYet / 1_000_000:N0} triệu";
                                }
                                @price <small style="font-size: 0.78rem; font-weight: 400; color: var(--text-muted);">VNĐ</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="deposit-card">
                        <h4>Thông tin đặt cọc</h4>
                        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">Vui lòng điền đầy đủ thông tin bên dưới</p>

                        <form method="post">
                            <input type="hidden" asp-for="DepositData.MaPhienBan" value="@Model.PhienBan.MaPhienBan" />

                            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                            {
                                <div style="background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3); color: #22c55e; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    <i class="fas fa-check-circle me-1"></i> @Model.SuccessMessage
                                </div>
                            }

                            @if (Model.IsPreOrder)
                            {
                                <div style="background: rgba(168,85,247,0.12); border: 1px solid rgba(168,85,247,0.3); color: #c084fc; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    <i class="fas fa-truck me-1"></i> Xe này hiện đã hết hàng. Bạn có thể <strong>đặt trước</strong> với cọc <strong>15%</strong> và chọn showroom để họ chuẩn bị xe cho bạn.
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="DepositData.HoTen" class="form-label">Họ tên</label>
                                    <input asp-for="DepositData.HoTen" class="form-control" required placeholder="Nhập họ tên" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DepositData.SoDienThoai" class="form-label">Số điện thoại</label>
                                    <input asp-for="DepositData.SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="DepositData.DiaChi" class="form-label">Địa chỉ</label>
                                    <input asp-for="DepositData.DiaChi" class="form-control" required placeholder="Nhập địa chỉ" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="MaChiNhanh" class="form-label">Showroom nguồn <span style="color:var(--text-faint);">(nơi chuẩn bị xe)</span></label>
                                    <select asp-for="MaChiNhanh" class="form-control" required>
                                        <option value="">-- Chọn showroom --</option>
                                        @foreach (var cn in Model.DanhSachChiNhanh)
                                        {
                                            <option value="@cn.MaChiNhanh">@cn.TenChiNhanh (@cn.DiaChi)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DepositData.PhuongThucThanhToan" class="form-label">Phương thức thanh toán</label>
                                    <select asp-for="DepositData.PhuongThucThanhToan" class="form-control" required>
                                        <option value="">-- Chọn --</option>
                                        <option value="Tiền mặt">Tiền mặt</option>
                                        <option value="Chuyển khoản">Chuyển khoản</option>
                                        <option value="Thẻ tín dụng">Thẻ tín dụng</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label asp-for="DepositData.SoTienCoc" class="form-label">Số tiền cọc (VNĐ) — @(Model.IsPreOrder ? "15%" : "20%") giá xe</label>
                                    <input asp-for="DepositData.SoTienCoc" type="number" class="form-control" required placeholder="VD: 50,000,000" value="@DepositCalculator.Compute(Model.PhienBan.GiaNiemYet, Model.IsPreOrder)" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="DepositData.GhiChu" class="form-label">Ghi chú</label>
                                    <textarea asp-for="DepositData.GhiChu" class="form-control" rows="3" placeholder="Nhập ghi chú nếu có..."></textarea>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn-premium btn-premium-solid" style="flex: 1; justify-content: center; padding: 0.7rem;">
                                    <i class="fas fa-check"></i> Xác nhận đặt cọc
                                </button>
                                <a asp-page="/Details" asp-route-id="@Model.PhienBan.MaDong" class="btn-premium btn-premium-outline" style="flex: 0 0 auto; padding: 0.7rem 1.5rem;">
                                    Hủy
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Loading overlay -->
<div id="depositLoadingOverlay" style="display:none; position:fixed; inset:0; z-index:9999; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); align-items:center; justify-content:center; flex-direction:column;">
    <div style="width:60px;height:60px;border:4px solid rgba(255,255,255,0.1);border-top-color:var(--brand-gold);border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:1.5rem;"></div>
    <div style="color:var(--brand-white);font-size:1.1rem;font-weight:600;">Đang xử lý đặt cọc...</div>
    <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.5rem;">Vui lòng chờ trong giây lát</div>
</div>

<style>
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
    document.querySelector('.deposit-card form')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;
        var formData = new FormData(form);
        formData.append('_ajax', 'true');

        document.getElementById('depositLoadingOverlay').style.display = 'flex';

        fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            document.getElementById('depositLoadingOverlay').style.display = 'none';
            if (data.success) {
                showPaymentModal(data);
            } else {
                alert(data.error || 'Có lỗi xảy ra. Vui lòng thử lại.');
            }
        })
        .catch(function(err) {
            document.getElementById('depositLoadingOverlay').style.display = 'none';
            alert('Lỗi kết nối: ' + (err.message || 'Không thể kết nối máy chủ'));
        });
    });

    function showPaymentModal(data) {
        var modalHtml = '<div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static">' +
            '<div class="modal-dialog modal-dialog-centered modal-sm">' +
            '<div class="modal-content" style="background:#1a1a2e;border:1px solid rgba(255,255,255,0.1);border-radius:16px;">' +
            '<div class="modal-header border-0"><h5 class="modal-title" style="color:var(--brand-white);"><i class="fas fa-qrcode me-2" style="color:var(--brand-gold);"></i> Quét QR thanh toán</h5>' +
            '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>' +
            '<div class="modal-body text-center pb-4">' +
            '<p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem;">Quét mã QR để thanh toán <strong>đơn cọc</strong></p>' +
            '<div style="background:white;border-radius:12px;padding:8px;display:inline-block;margin-bottom:0.8rem;">' +
            '<img src="' + data.qrUrl + '" alt="QR" style="width:200px;height:200px;border-radius:8px;" /></div>' +
            '<div style="text-align:left;background:rgba(255,255,255,0.05);border-radius:8px;padding:0.8rem;font-size:0.78rem;">' +
            '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Số tiền</span><span style="color:var(--brand-gold);font-weight:700;">' + formatMoney(data.soTienCoc) + '</span></div>' +
            '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Ngân hàng</span><span style="color:var(--brand-white);">' + data.bankName + '</span></div>' +
            '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">STK</span><span style="color:var(--brand-white);font-weight:700;">' + data.bankNumber + '</span></div>' +
            '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Nội dung CK</span><span style="font-family:monospace;background:rgba(255,255,255,0.05);padding:0.1rem 0.3rem;border-radius:4px;color:var(--brand-gold);">' + data.maGiaoDich + '</span></div>' +
            '</div>' +
            '<p style="color:var(--text-faint);font-size:0.72rem;margin-top:0.8rem;" id="paymentStatus">Đang chờ thanh toán...</p>' +
            '</div></div></div></div>';

        var div = document.createElement('div');
        div.innerHTML = modalHtml;
        document.body.appendChild(div);

        var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
        modal.show();

        // Poll for payment status
        var pollTimer = setInterval(function() {
            fetch('/api/check-payment?maDonCoc=' + data.maDonCoc)
                .then(function(r) { return r.json(); })
                .then(function(status) {
                    if (status.paid) {
                        clearInterval(pollTimer);
                        document.getElementById('paymentModal').querySelector('.modal-body').innerHTML =
                            '<div style="padding:1rem;"><div style="width:60px;height:60px;border-radius:50%;background:rgba(34,197,94,0.15);border:2px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#22c55e;"><i class="fas fa-check"></i></div>' +
                            '<h5 style="color:var(--brand-white);">Thanh toán thành công!</h5>' +
                            '<p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem;">Đơn cọc đã được ghi nhận. Chúng tôi sẽ liên hệ sớm.</p>' +
                            '<a href="/Profile" class="btn-premium btn-premium-solid" style="justify-content:center;padding:0.6rem;display:flex;"><i class="fas fa-user me-1"></i> Xem đơn của tôi</a></div>';
                    }
                })
                .catch(function() {});
        }, 5000);

        document.getElementById('paymentModal').addEventListener('hidden.bs.modal', function() {
            clearInterval(pollTimer);
        });
    }

    function formatMoney(n) {
        if (n >= 1000000000) return (n / 1000000000).toFixed(1) + ' tỷ VNĐ';
        if (n >= 1000000) return (n / 1000000).toFixed(0) + ' triệu VNĐ';
        return n.toLocaleString('vi-VN') + ' VNĐ';
    }
</script>
