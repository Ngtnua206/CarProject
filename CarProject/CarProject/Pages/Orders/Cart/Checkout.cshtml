@page
@model CarProject.Pages.Orders.Cart.CheckoutModel
@{
    ViewData["Title"] = "Xác nhận đặt cọc";
    var cocRateText = (Model.CartItems.GroupBy(c => c.SoLuongTrongKho <= 0 ? "15%" : "20%").Count() == 1
        ? Model.CartItems.Any(c => c.SoLuongTrongKho <= 0) ? "15%" : "20%"
        : "15%/20%");
}

<div class="deposit-page">
    <div class="container py-4">
        <nav class="breadcrumb-premium mb-4">
            <a asp-page="/Index"><i class="fas fa-home"></i> Trang chủ</a>
            <span>/</span>
            <a asp-page="/Orders/Cart/Index">Giỏ hàng</a>
            <span>/</span>
            <span>Xác nhận</span>
        </nav>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="deposit-card">
                    <h4>Danh sách xe (@Model.CartItems.Count xe)</h4>
                    <div style="max-height: 400px; overflow-y: auto; margin-top: 1rem;">
                        @foreach (var item in Model.CartItems)
                        {
                            var isPreOrder = item.SoLuongTrongKho <= 0;
                            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 0.8rem; margin-bottom: 0.5rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight: 600; color: var(--brand-white); font-size: 0.9rem;">
                                            @item.TenPhienBan
                                            @if (isPreOrder)
                                            {
                                                <span style="font-size:0.65rem;background:rgba(168,85,247,0.15);color:#a855f7;padding:0.15rem 0.5rem;border-radius:50px;margin-left:0.5rem;">Đặt trước</span>
                                            }
                                        </div>
                                        <div style="font-size: 0.75rem; color: var(--text-faint);">@item.TenDong - @item.MauSac</div>
                                    </div>
                                    <div style="text-align:right;flex-shrink:0;">
                                        @{
                                            var priceTotal = (long)item.GiaNiemYet * item.SoLuong;
                                            var lineTotal = item.SoTienCoc * item.SoLuong;
                                            var rate = isPreOrder ? "15%" : "20%";
                                            var fmtT = (decimal v) => v >= 1_000_000_000 ? $"{v / 1_000_000_000:N2} tỷ" : $"{v / 1_000_000:N0} triệu";
                                        }
                                        <div style="font-size:0.68rem;color: var(--text-faint);">Giá gốc: @(item.GiaNiemYet >= 1_000_000_000 ? $"{item.GiaNiemYet / 1_000_000_000:N2} tỷ" : $"{item.GiaNiemYet / 1_000_000:N0} triệu") @(item.SoLuong > 1 ? $"x {item.SoLuong}" : "")</div>
                                        <div style="font-size:0.72rem;color: var(--text-faint);">Tổng giá gốc: @fmtT(priceTotal)</div>
                                        <div style="font-weight: 700; color: var(--brand-gold); font-size: 0.9rem;">Cọc @rate: @fmtT(lineTotal)</div>
                                        <div style="font-size:0.68rem;color: var(--text-faint);">@item.SoTienCoc.ToString("N0")đ / xe @(isPreOrder ? "(15% cọc)" : "(20% cọc)")@(item.SoLuong > 1 ? $" x{item.SoLuong}" : "")</div>
                                    </div>
                                </div>
                                <div style="margin-top: 0.4rem; display: flex; align-items: center; gap: 0.5rem;">
                                    <label style="font-size: 0.72rem; color: var(--text-muted);">Số lượng:</label>
                                    <input type="number" name="QuantityInput[@item.MaPhienBan]" value="@item.SoLuong" min="1" max="@(isPreOrder ? 10 : item.SoLuong)"
                                           class="form-control" style="width: 70px; font-size: 0.82rem; padding: 0.25rem 0.5rem;" />
                                </div>
                                @if (isPreOrder)
                                {
                                    <div style="margin-top: 0.4rem; font-size: 0.72rem; color: var(--text-faint);">
                                        <i class="fas fa-truck me-1"></i> Xe đặt trước — showroom được chọn sẽ chuẩn bị xe cho bạn.
                                    </div>
                                }
                                else if (Model.TonKhoTheoPhienBan.TryGetValue(item.MaPhienBan, out var tonKhoList) && tonKhoList.Any())
                                {
                                    <div style="margin-top: 0.4rem; padding-top: 0.4rem; border-top: 1px solid rgba(255,255,255,0.04); font-size: 0.72rem; color: var(--text-faint); display: flex; flex-wrap: wrap; gap: 0.4rem;">
                                        @foreach (var tk in tonKhoList)
                                        {
                                            var avail = Model.TonKhoConLaiLut.TryGetValue((item.MaPhienBan, tk.MaChiNhanh), out var a) ? a : tk.SoLuong;
                                            <span style="background: rgba(255,255,255,0.04); padding: 0.15rem 0.5rem; border-radius: 4px;">
                                                @tk.ChiNhanh?.TenChiNhanh: <strong style="color: var(--brand-gold);">@(avail > 0 ? $"còn {avail}" : "hết")</strong>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; gap: 0.3rem;">
                        <span style="color: var(--text-muted);">Tổng tiền gốc (@Model.CartItems.Sum(c => c.SoLuong) xe)</span>
                        <span style="font-weight: 600; color: var(--brand-gold); font-size: 1rem;">
                            @{
                                var totalGoc = Model.CartItems.Sum(c => (long)c.GiaNiemYet * c.SoLuong);
                            }
                            @(totalGoc >= 1_000_000_000
                                ? $"{totalGoc / 1_000_000_000:N2} tỷ"
                                : $"{totalGoc / 1_000_000:N0} triệu") VNĐ
                        </span>
                        <span style="color: var(--text-muted);">Tổng tiền cọc @cocRateText</span>
                        <span style="font-weight: 700; color: var(--brand-gold); font-size: 1.2rem;">
                            @(Model.TotalDeposit >= 1_000_000_000
                                ? $"{Model.TotalDeposit / 1_000_000_000:N2} tỷ"
                                : $"{Model.TotalDeposit / 1_000_000:N0} triệu") VNĐ
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="deposit-card">
                    <h4>Thông tin người đặt</h4>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">Điền thông tin để hoàn tất đặt cọc</p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                            <i class="fas fa-exclamation-circle me-1"></i> @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ tên</label>
                                <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ tên" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số điện thoại</label>
                                <input asp-for="SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Địa chỉ</label>
                                <input asp-for="DiaChi" class="form-control" required placeholder="Nhập địa chỉ" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phương thức thanh toán</label>
                                <select asp-for="PhuongThucThanhToan" class="form-control" required onchange="toggleCheckoutMap()">
                                    <option value="">-- Chọn --</option>
                                    <option value="Chuyển khoản">Chuyển khoản</option>
                                    <option value="Tiền mặt">Tiền mặt</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                @{
                                    var cnCoXe = Model.TonKhoTheoPhienBan.Values
                                        .SelectMany(l => l)
                                        .Where(t => t.SoLuong > 0)
                                        .Select(t => t.MaChiNhanh)
                                        .Distinct()
                                        .ToHashSet();
                                    var showroomsHep = Model.DanhSachChiNhanh.Where(c => cnCoXe.Contains(c.MaChiNhanh)).ToList();
                                    if (showroomsHep.Count == 0) showroomsHep = Model.DanhSachChiNhanh;
                                }
                                <label class="form-label">Showroom hẹn gặp (nhận xe)</label>
                                <select asp-for="MaChiNhanh" class="form-control" required>
                                    <option value="">-- Chọn showroom --</option>
                                    @foreach (var cn in showroomsHep)
                                    {
                                        <option value="@cn.MaChiNhanh">@cn.TenChiNhanh (@cn.DiaChi)</option>
                                    }
                                </select>
                                <small style="color: var(--text-faint); font-size: 0.72rem;">Chỉ hiển thị các showroom đang có xe nguồn của đơn hàng để tránh phát sinh chi phí vận chuyển. Xe sẽ ưu tiên lấy từ showroom này trước.</small>
                            </div>
                            <div class="col-12" id="cashMapBlock">
                                        <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 0.8rem;">
                                            <label class="form-label" style="font-size: 0.85rem;"><i class="fas fa-map-marker-alt me-1" style="color: var(--brand-gold);"></i> Địa điểm nhân viên quản lý đến thu tiền cọc <span style="color: var(--brand-gold);">*</span></label>
                                            <input asp-for="DiaDiemGap" type="hidden" />
                                            <input asp-for="ToaDoGap" type="hidden" />
                                            <div class="row g-2">
                                                <div class="col-md-4">
                                                    <select id="vnProvince" class="form-control">
                                                        <option value="">-- Chọn Tỉnh / Thành phố --</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <select id="vnDistrict" class="form-control" disabled>
                                                        <option value="">-- Chọn Quận / Huyện --</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <input id="vnDetail" class="form-control" placeholder="Số nhà / Thôn / Xóm / Chi tiết" />
                                                </div>
                                            </div>
                                            <div id="checkoutMap" style="height: 300px; border-radius: 10px; margin-top: 0.5rem; border: 1px solid rgba(255,255,255,0.12); z-index: 0;"></div>
                                            <small style="color: var(--text-faint); font-size: 0.72rem;">Chọn tỉnh/huyện, nhập số nhà/thôn, rồi <strong>bấm vào bản đồ</strong> để trỏ đúng vị trí gặp. Toạ độ được chọn sẽ được gửi tới nhân viên quản lý đến đúng chỗ thu tiền cọc.</small>
                                        </div>
                                    </div>
                            <div class="col-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Nhập ghi chú nếu có..."></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn-premium btn-premium-solid" style="flex: 1; justify-content: center; padding: 0.7rem;">
                                <i class="fas fa-check"></i> Xác nhận đặt cọc @cocRateText
                            </button>
                            <a asp-page="/Orders/Cart/Index" class="btn-premium btn-premium-outline" style="flex: 0 0 auto; padding: 0.7rem 1.5rem;">
                                Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading overlay -->
<div id="checkoutLoadingOverlay" style="display:none; position:fixed; inset:0; z-index:9999; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); align-items:center; justify-content:center; flex-direction:column;">
    <div style="width:60px;height:60px;border:4px solid rgba(255,255,255,0.1);border-top-color:var(--brand-gold);border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:1.5rem;"></div>
    <div style="color:var(--brand-white);font-size:1.1rem;font-weight:600;">Đang xử lý đặt cọc...</div>
    <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.5rem;">Vui lòng chờ trong giây lát</div>
</div>

<style>
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/vn-admin.js"></script>

<script>
    var checkoutMap = null;
    var checkoutMarker = null;

    function toggleCheckoutMap() {
        var block = document.getElementById('cashMapBlock');
        if (block) block.style.display = '';
        initCheckoutMap();
    }

    function provinceCenter(prov) {
        var c = (typeof VNCENTROID !== 'undefined') ? VNCENTROID[prov] : null;
        if (c) {
            var p = c.split(',');
            return [parseFloat(p[0]), parseFloat(p[1])];
        }
        return [16.0, 108.0];
    }

    function buildDiaDiem() {
        var provEl = document.getElementById('vnProvince');
        var distEl = document.getElementById('vnDistrict');
        var detEl = document.getElementById('vnDetail');
        var parts = [];
        if (detEl && detEl.value.trim()) parts.push(detEl.value.trim());
        if (distEl && distEl.value) parts.push(distEl.value);
        if (provEl && provEl.value) parts.push(provEl.value);
        return parts.join(', ');
    }

    function setCheckoutLocation(lat, lng) {
        if (!checkoutMap) return;
        if (!checkoutMarker) {
            checkoutMarker = L.marker([lat, lng]).addTo(checkoutMap);
        } else {
            checkoutMarker.setLatLng([lat, lng]);
        }
        var toaDo = document.querySelector('[name="ToaDoGap"]');
        var diaDiem = document.querySelector('[name="DiaDiemGap"]');
        if (toaDo) toaDo.value = lat.toFixed(6) + ',' + lng.toFixed(6);
        if (diaDiem) diaDiem.value = buildDiaDiem() || (lat.toFixed(5) + ', ' + lng.toFixed(5));
    }

    function initCheckoutMap() {
        var container = document.getElementById('checkoutMap');
        if (!container || typeof L === 'undefined') return;
        if (checkoutMap) { checkoutMap.invalidateSize(); return; }
        checkoutMap = L.map('checkoutMap', { zoomControl: true, attributionControl: false }).setView([16.821, 108.0], 5);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '' }).addTo(checkoutMap);
        checkoutMap.on('click', function(e) {
            setCheckoutLocation(e.latlng.lat, e.latlng.lng);
        });
        populateCascade();
    }

    function populateCascade() {
        if (typeof VNCITY === 'undefined') return;
        var provEl = document.getElementById('vnProvince');
        if (!provEl) return;
        var keys = Object.keys(VNCITY).sort(function (a,b) { return a.localeCompare(b, 'vi'); });
        keys.forEach(function(k) {
            var o = document.createElement('option');
            o.value = k; o.textContent = k;
            provEl.appendChild(o);
        });
        var distEl = document.getElementById('vnDistrict');
        provEl.addEventListener('change', function() {
            distEl.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
            var dl = VNCITY[provEl.value];
            if (dl && dl.length) {
                distEl.disabled = false;
                dl.forEach(function(d) {
                    var o = document.createElement('option');
                    o.value = d; o.textContent = d;
                    distEl.appendChild(o);
                });
            } else {
                distEl.disabled = true;
            }
            if (checkoutMap) checkoutMap.setView(provinceCenter(provEl.value), 11);
            var diaDiem = document.querySelector('[name="DiaDiemGap"]');
            if (diaDiem) diaDiem.value = buildDiaDiem();
        });
        distEl.addEventListener('change', function() {
            var diaDiem = document.querySelector('[name="DiaDiemGap"]');
            if (diaDiem) diaDiem.value = buildDiaDiem();
        });
        var detEl = document.getElementById('vnDetail');
        if (detEl) detEl.addEventListener('input', function() {
            var diaDiem = document.querySelector('[name="DiaDiemGap"]');
            if (diaDiem) diaDiem.value = buildDiaDiem();
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        var paymentEl = document.querySelector('[name="PhuongThucThanhToan"]');
        if (paymentEl) {
            paymentEl.addEventListener('change', toggleCheckoutMap);
            toggleCheckoutMap();
        }
    });
</script>



<script>
    document.querySelector('.deposit-card form')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;
        var diaDiemEl = form.querySelector('[name="DiaDiemGap"]');
        if (!diaDiemEl || !diaDiemEl.value) {
            alert('Vui lòng chọn địa điểm nhân viên quản lý đến thu tiền cọc trên bản đồ.');
            return;
        }
        var formData = new FormData(form);
        formData.append('_ajax', 'true');

        document.getElementById('checkoutLoadingOverlay').style.display = 'flex';

        fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        })
        .then(function(r) {
            var ct = r.headers.get('content-type') || '';
            if (ct.indexOf('application/json') === -1) {
                return r.text().then(function(t) { throw new Error('Server returned non-JSON response:\n' + t); });
            }
            return r.json();
        })
        .then(function(data) {
            document.getElementById('checkoutLoadingOverlay').style.display = 'none';
            if (data.success) {
                showPaymentModal(data);
            } else {
                alert(data.error || 'Có lỗi xảy ra. Vui lòng thử lại.');
            }
        })
        .catch(function(err) {
            document.getElementById('checkoutLoadingOverlay').style.display = 'none';
            alert('Lỗi kết nối: ' + (err.message || 'Không thể kết nối máy chủ'));
        });
    });

    function showPaymentModal(data) {
        var isCash = (data.paymentMethod || '').toLowerCase() === 'tiền mặt' || (data.paymentMethod || '').toLowerCase() === 'tien mat';
        var bodyHtml = isCash
            ? '<div style="padding:0.75rem 0 0.25rem;text-align:left;">' +
              '<div style="display:flex;align-items:center;gap:0.6rem;padding:0.8rem 1rem;border-radius:10px;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.25);margin-bottom:0.9rem;">' +
              '<i class="fas fa-money-bill-wave" style="color:#22c55e;font-size:1rem;"></i>' +
              '<div><div style="color:var(--brand-white);font-weight:600;">Đơn của bạn đang chờ thanh toán</div><div style="color:var(--text-muted);font-size:0.78rem;">Admin và showroom sẽ kiểm tra đơn để xác nhận.</div></div></div>' +
              '<div style="background:rgba(255,255,255,0.05);border-radius:8px;padding:0.8rem;font-size:0.78rem;color:var(--text-muted);">' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span>Tổng tiền cọc</span><span style="color:var(--brand-gold);font-weight:700;">' + formatMoney(data.soTienCoc) + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span>Mã đơn</span><span style="color:var(--brand-white);font-weight:700;">#' + data.maDonCoc + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span>Trạng thái</span><span style="color:#22c55e;font-weight:700;">' + (data.orderStatus || 'Chờ thanh toán') + '</span></div>' +
              '</div>' +
              '<p style="color:var(--text-faint);font-size:0.72rem;margin-top:0.8rem;">Đơn đã được ghi nhận. Chúng tôi sẽ gửi thông tin cho admin/showroom để xử lý sớm nhất.</p>' +
              '<div style="margin-top:0.9rem;text-align:center;"><a href="' + (data.orderUrl || '/Profile') + '" class="btn-premium btn-premium-solid" style="display:inline-flex;align-items:center;justify-content:center;padding:0.6rem 1rem;">' +
              '<i class="fas fa-eye me-1"></i> Xem trạng thái đơn</a></div>' +
              '</div>'
            : '<div style="text-align:left;background:rgba(255,255,255,0.05);border-radius:8px;padding:0.8rem;font-size:0.78rem;">' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Tổng tiền gốc</span><span style="color:var(--brand-white);">' + formatMoney(data.tongTienGoc) + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Số tiền cọc (' + (data.cocRateText || '20%') + ')</span><span style="color:var(--brand-gold);font-weight:700;">' + formatMoney(data.soTienCoc) + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Ngân hàng</span><span style="color:var(--brand-white);">' + data.bankName + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">STK</span><span style="color:var(--brand-white);font-weight:700;">' + data.bankNumber + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Nội dung CK</span><span style="font-family:monospace;background:rgba(255,255,255,0.05);padding:0.1rem 0.3rem;border-radius:4px;color:var(--brand-gold);">' + data.maGiaoDich + '</span></div>' +
              '</div>' +
              '<div style="background:white;border-radius:12px;padding:8px;display:inline-block;margin-top:0.8rem;">' +
              '<img src="' + (data.qrUrl || '') + '" alt="QR" style="width:200px;height:200px;border-radius:8px;" /></div>' +
              '<p style="color:var(--text-faint);font-size:0.72rem;margin-top:0.8rem;" id="paymentStatus">Đang chờ thanh toán...</p>';
        var modalHtml = '<div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static">' +
            '<div class="modal-dialog modal-dialog-centered modal-sm">' +
            '<div class="modal-content" style="background:#1a1a2e;border:1px solid rgba(255,255,255,0.1);border-radius:16px;">' +
            '<div class="modal-header border-0"><h5 class="modal-title" style="color:var(--brand-white);"><i class="fas ' + (isCash ? 'fa-money-bill-wave' : 'fa-qrcode') + ' me-2" style="color:var(--brand-gold);"></i> ' + (isCash ? 'Đơn chờ thanh toán' : 'Quét QR thanh toán') + '</h5>' +
            '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>' +
            '<div class="modal-body text-center pb-4">' +
            '<p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem;">' + (isCash ? 'Đơn cọc đã được ghi nhận để admin/showroom kiểm tra' : 'Quét mã QR để thanh toán <strong>đơn cọc</strong>') + '</p>' +
            bodyHtml +
            '</div></div></div></div>';

        var div = document.createElement('div');
        div.innerHTML = modalHtml;
        document.body.appendChild(div);

        var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
        modal.show();

        // Poll for payment status
        var pollTimer = setInterval(function() {
            fetch('/api/check-payment?maDonCoc=' + data.maDonCoc)
                .then(function(r) { return r.json(); })
                .then(function(status) {
                    if (status.paid) {
                        clearInterval(pollTimer);
                        document.getElementById('paymentModal').querySelector('.modal-body').innerHTML =
                            '<div style="padding:1rem;"><div style="width:60px;height:60px;border-radius:50%;background:rgba(34,197,94,0.15);border:2px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#22c55e;"><i class="fas fa-check"></i></div>' +
                            '<h5 style="color:var(--brand-white);">Thanh toán thành công!</h5>' +
                            '<p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem;">Đơn cọc đã được ghi nhận. Chúng tôi sẽ liên hệ sớm.</p>' +
                            '<a href="/Profile" class="btn-premium btn-premium-solid" style="justify-content:center;padding:0.6rem;display:flex;"><i class="fas fa-user me-1"></i> Xem đơn của tôi</a></div>';
                    }
                })
                .catch(function() {});
        }, 5000);

        document.getElementById('paymentModal').addEventListener('hidden.bs.modal', function() {
            clearInterval(pollTimer);
        });
    }

    function formatMoney(n) {
        if (n >= 1000000000) return (n / 1000000000).toFixed(2) + ' tỷ VNĐ';
        if (n >= 1000000) return (n / 1000000).toFixed(0) + ' triệu VNĐ';
        return n.toLocaleString('vi-VN') + ' VNĐ';
    }
</script>