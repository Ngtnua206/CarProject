@page
@model TestDriveModel

@{
    ViewData["Title"] = "Đăng ký lái thử";
}

<div class="deposit-page">
    <div class="container py-4">
        <nav class="breadcrumb-premium mb-4">
            <a asp-page="/Index"><i class="fas fa-home"></i> Trang chủ</a>
            <span>/</span>
            <span>Đăng ký lái thử</span>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="deposit-card p-4">
                    <h4>Đặt lịch lái thử showroom</h4>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">Đặt trước lịch lái thử có phí 1.000.000₫. Thanh toán tiền mặt hoặc chuyển khoản tại showroom, phòng vé để giữ chỗ.</p>

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div style="background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3); color: #22c55e; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                            <i class="fas fa-check-circle me-1"></i> @Model.SuccessMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                            <i class="fas fa-exclamation-circle me-1"></i> @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ và tên</label>
                                <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ tên" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số điện thoại</label>
                                <input asp-for="SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số bằng lái xe</label>
                                <input asp-for="SoBangLaiXe" class="form-control" required placeholder="Nhập số bằng lái" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Chọn dòng xe</label>
                                <select asp-for="MaDong" class="form-control" required>
                                    <option value="">-- Chọn dòng xe --</option>
                                    @foreach (var d in Model.DanhSachXe)
                                    {
                                        <option value="@d.MaDong">@d.TenDong</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Chọn showroom</label>
                                <select asp-for="MaChiNhanh" class="form-control" required>
                                    <option value="">-- Chọn chi nhánh --</option>
                                    @foreach (var cn in Model.DanhSachChiNhanh)
                                    {
                                        <option value="@cn.MaChiNhanh">@cn.TenChiNhanh</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phương thức thanh toán</label>
                                <select asp-for="PhuongThucThanhToan" class="form-control" required>
                                    <option value="">-- Chọn phương thức --</option>
                                    <option value="Chuyển khoản">Chuyển khoản</option>
                                    <option value="Tiền mặt">Tiền mặt</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ngày hẹn</label>
                                <input asp-for="NgayHen" type="date" class="form-control" required min="@DateTime.Today.AddDays(3):yyyy-MM-dd" max="@DateTime.Today.AddMonths(1):yyyy-MM-dd" />
                                <small class="text-muted" style="font-size:0.8rem;">Ngày hẹn phải cách ít nhất 3 ngày và tối đa 1 tháng.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Giờ hẹn</label>
                                <select asp-for="GioHen" class="form-control" required>
                                    <option value="">-- Chọn giờ --</option>
                                    <option value="08:00">08:00</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:00">10:00</option>
                                    <option value="11:00">11:00</option>
                                    <option value="13:00">13:00</option>
                                    <option value="14:00">14:00</option>
                                    <option value="15:00">15:00</option>
                                    <option value="16:00">16:00</option>
                                    <option value="17:00">17:00</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Yêu cầu đặc biệt (nếu có)..."></textarea>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn-premium btn-premium-solid" style="padding: 0.8rem 3rem;">
                                <i class="fas fa-calendar-check me-2"></i> Đặt lịch hẹn
                            </button>
                        </div>
                        <div class="mt-3" style="font-size:0.85rem;color:var(--text-muted);">
                            <i class="fas fa-info-circle me-1"></i> Phí đặt lịch: <strong>1.000.000₫</strong>. Showroom sẽ liên hệ và xác nhận booking sau khi nhận thanh toán.
                        </div>
                    </form>

                    <div id="testDriveLoadingOverlay" style="display:none; position:fixed; inset:0; z-index:9999; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); align-items:center; justify-content:center; flex-direction:column;">
                        <div style="width:60px;height:60px;border:4px solid rgba(255,255,255,0.1);border-top-color:var(--brand-gold);border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:1.5rem;"></div>
                        <div style="color:var(--brand-white);font-size:1.1rem;font-weight:600;">Đang xử lý yêu cầu...</div>
                        <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.5rem;">Vui lòng chờ trong giây lát</div>
                    </div>

                    @if (Model.ShowQr)
                    {
                        <div class="bank-card mt-4" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 1.5rem;">
                            <h5 style="margin-bottom: 1rem; color: var(--brand-white);">Thông tin chuyển khoản</h5>
                            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 0.9rem;">
                                <span style="color: var(--text-muted);">Ngân hàng thụ hưởng</span>
                                <span style="color: var(--brand-white); font-weight: 600;">@Model.BankName</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 0.9rem;">
                                <span style="color: var(--text-muted);">Số tài khoản</span>
                                <span style="color: var(--brand-white); font-weight: 600;">@Model.BankNumber</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 0.9rem;">
                                <span style="color: var(--text-muted);">Chủ tài khoản</span>
                                <span style="color: var(--brand-white); font-weight: 600;">@Model.AccountName</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; font-size: 0.9rem;">
                                <span style="color: var(--text-muted);">Nội dung chuyển khoản</span>
                                <span style="color: var(--brand-white); font-weight: 700; font-family: monospace;">@Model.TransferContent</span>
                            </div>

                            <div style="display:flex;justify-content:center;margin:1rem 0 0.5rem;">
                                <div style="background:white;border-radius:12px;padding:8px;display:inline-block;">
                                    <img src="@Model.QrImageUrl" alt="QR thanh toán" style="width:200px;height:200px;border-radius:8px;" />
                                </div>
                            </div>

                            <p style="color: var(--text-muted); font-size: 0.82rem; margin-top: 1rem;">
                                Vui lòng quét mã QR để thanh toán 1.000.000₫ và giữ chỗ lái thử. Ghi đúng nội dung chuyển khoản để showroom đối soát.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
    document.querySelector('.deposit-page form')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;
        var paymentMethod = form.querySelector('[name="PhuongThucThanhToan"]').value || '';
        var isTransfer = paymentMethod.toLowerCase() === 'chuyển khoản';

        var formData = new FormData(form);
        formData.append('_ajax', 'true');

        document.getElementById('testDriveLoadingOverlay').style.display = 'flex';

        fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: { 'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            document.getElementById('testDriveLoadingOverlay').style.display = 'none';
            if (data.success) {
                if (isTransfer) {
                    showPaymentModal(data);
                } else {
                    window.location.reload();
                }
            } else {
                alert(data.error || 'Có lỗi xảy ra. Vui lòng thử lại.');
            }
        })
        .catch(function(err) {
            document.getElementById('testDriveLoadingOverlay').style.display = 'none';
            alert('Lỗi kết nối: ' + (err.message || 'Không thể kết nối máy chủ'));
        });
    });

    function formatMoney(n) {
        if (n >= 1000000000) return (n / 1000000000).toFixed(2) + ' tỷ VNĐ';
        if (n >= 1000000) return (n / 1000000).toFixed(0) + ' triệu VNĐ';
        return n.toLocaleString('vi-VN') + ' VNĐ';
    }

    function showPaymentModal(data) {
        var bodyHtml = '<div style="text-align:left;background:rgba(255,255,255,0.05);border-radius:8px;padding:0.8rem;font-size:0.78rem;">' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Số tiền</span><span style="color:var(--brand-gold);font-weight:700;">' + formatMoney(1000000) + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Ngân hàng</span><span style="color:var(--brand-white);">' + (data.bankName || '') + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">STK</span><span style="color:var(--brand-white);font-weight:700;">' + (data.bankNumber || '') + '</span></div>' +
              '<div style="display:flex;justify-content:space-between;padding:0.3rem 0;"><span style="color:var(--text-muted);">Nội dung CK</span><span style="font-family:monospace;background:rgba(255,255,255,0.05);padding:0.1rem 0.3rem;border-radius:4px;color:var(--brand-gold);">' + (data.maGiaoDich || '') + '</span></div>' +
              '</div>' +
              '<div style="background:white;border-radius:12px;padding:8px;display:inline-block;margin-top:0.8rem;">' +
              '<img src="' + (data.qrUrl || '') + '" alt="QR" style="width:200px;height:200px;border-radius:8px;" />' +
              '</div>' +
              '<p style="color:var(--text-faint);font-size:0.72rem;margin-top:0.8rem;" id="paymentStatus">Đang chờ webhook xác nhận thanh toán...</p>';

        var modalHtml = '<div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static">' +
            '<div class="modal-dialog modal-dialog-centered modal-sm">' +
            '<div class="modal-content" style="background:#1a1a2e;border:1px solid rgba(255,255,255,0.1);border-radius:16px;">' +
            '<div class="modal-header border-0"><h5 class="modal-title" style="color:var(--brand-white);"><i class="fas fa-qrcode me-2" style="color:var(--brand-gold);"></i> Quét QR thanh toán</h5>' +
            '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>' +
            '<div class="modal-body text-center pb-4">' +
            '<p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem;">Quét mã QR để thanh toán 10.000₫. Sau khi bên SePay xử lý, đơn lái thử sẽ được gửi đến showroom.</p>' +
            bodyHtml +
            '</div></div></div></div>';

        var div = document.createElement('div');
        div.innerHTML = modalHtml;
        document.body.appendChild(div);

        var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
        modal.show();

        var pollTimer = setInterval(function() {
            fetch('/api/check-payment?maDonCoc=' + encodeURIComponent(data.maGiaoDich))
                .then(function(r) { return r.json(); })
                .then(function(status) {
                    if (status.paid) {
                        clearInterval(pollTimer);
                        var body = document.getElementById('paymentModal').querySelector('.modal-body');
                        if (body) {
                            body.innerHTML =
                                '<div style="padding:1rem;">' +
                                '<div style="width:60px;height:60px;border-radius:50%;background:rgba(34,197,94,0.15);border:2px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:#22c55e;"><i class="fas fa-check"></i></div>' +
                                '<h5 style="color:var(--brand-white);">Thanh toán thành công!</h5>' +
                                '<p style="color:var(--text-muted);font-size:0.82rem;margin-bottom:1rem;">Đơn lái thử của bạn đã được xác nhận và sẽ được gửi tới showroom.</p>' +
                                '<a href="/Profile" class="btn-premium btn-premium-solid" style="justify-content:center;padding:0.6rem;display:flex;"><i class="fas fa-user me-1"></i> Xem đơn của tôi</a></div>';
                        }
                    }
                })
                .catch(function() {});
        }, 5000);

        document.getElementById('paymentModal').addEventListener('hidden.bs.modal', function() {
            clearInterval(pollTimer);
            document.getElementById('paymentModal').remove();
        });
    }
</script>
