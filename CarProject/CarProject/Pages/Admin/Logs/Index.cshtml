@page
@model CarProject.Pages.Admin.Logs.IndexModel

@{
    ViewData["Title"] = "Nhật ký hoạt động";
}

<div class="container-fluid db-wrap">
    <div class="db-toolbar">
        <div>
            <h1 class="db-title">Nhật ký hoạt động</h1>
            <div class="db-subtitle">Tổng: @Model.TotalCount bản ghi</div>
        </div>
        <a asp-page="/Admin/Index" class="db-btn-primary">
            <i class="fas fa-arrow-left me-1"></i> Về Dashboard
        </a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input name="SearchAction" class="form-control" placeholder="Tìm theo hành động..." value="@Model.SearchAction" />
        </div>
        @if (User.GetJwtRole() == "Admin")
        {
            <div class="col-md-3">
                <input name="SearchUser" class="form-control" placeholder="Tìm theo tài khoản..." value="@Model.SearchUser" />
            </div>
        }
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Lọc</button>
        </div>
        <div class="col-md-2">
            <a asp-page="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
        </div>
    </form>

    @if (Model.Logs.Count == 0)
    {
        <div class="alert alert-info">Chưa có nhật ký nào.</div>
    }
    else
    {
        <div class="db-card">
            <div class="db-table-responsive">
                <table class="db-table" style="min-width:1220px;">
                    <colgroup>
                        <col style="width:160px" />
                        <col style="width:150px" />
                        <col style="width:100px" />
                        <col style="width:200px" />
                        <col style="width:280px" />
                        <col style="width:130px" />
                        <col style="width:200px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Người dùng</th>
                            <th>Vai trò</th>
                            <th>Hành động</th>
                            <th>Chi tiết</th>
                            <th>IP</th>
                            <th>Đường dẫn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>
                                    <div class="db-date">@log.ThoiGian.ToLocalTime().ToString("dd/MM/yyyy")<small>@log.ThoiGian.ToLocalTime().ToString("HH:mm:ss")</small></div>
                                </td>
                                <td>
                                    <div class="db-name">@log.TenDangNhap</div>
                                </td>
                                <td>
                                    <span class="db-badge @(log.VaiTro == "Admin" ? "red" : "gray")">@log.VaiTro</span>
                                </td>
                                <td>
                                    <div class="db-name">@log.HanhDong</div>
                                </td>
                                <td>
                                    <div class="db-2line">@log.ChiTiet</div>
                                </td>
                                <td>
                                    <div class="db-name">@log.DiaChiIP</div>
                                </td>
                                <td>
                                    <div class="db-2line">@log.DuongDan</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-p="@i" asp-route-SearchAction="@Model.SearchAction" asp-route-SearchUser="@Model.SearchUser">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>