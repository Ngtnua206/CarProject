@page
@model CarProject.Pages.QuanLy.DonCocModel
@{
    ViewData["Title"] = "Quản lý đơn cọc";
    Layout = "_Layout";
}

<style>
    .ql-header { background: linear-gradient(135deg, #1a1a2e, #16213e); color: #fff; padding: 2rem 0; margin-bottom: 2rem; }
    .ql-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 1.5rem; }
    .badge-waiting { background: #fef3c7; color: #92400e; }
    .badge-confirmed { background: #d1fae5; color: #065f46; }
    .badge-rejected { background: #fee2e2; color: #991b1b; }
    .badge-completed { background: #e0e7ff; color: #3730a3; }
    .badge-cancelled { background: #f3e8ff; color: #6b21a8; }
</style>

<div class="ql-header">
    <div class="container">
        <h1 style="font-size: 1.5rem; font-weight: 600; margin: 0;">
            <i class="fas fa-file-invoice me-2"></i> Quản lý đơn cọc
        </h1>
        @if (Model.Showroom != null)
        {
            <p class="mb-0 mt-1" style="opacity: 0.7;">Showroom: <strong>@Model.Showroom.TenChiNhanh</strong></p>
        }
    </div>
</div>

<div class="container" style="padding-bottom: 3rem;">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (!Model.DanhSachDonCoc.Any())
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.2;"><i class="fas fa-file-invoice"></i></div>
            <h4 style="color: #333;">Chưa có đơn cọc nào</h4>
        </div>
    }
    else
    {
        <div class="ql-card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th>Tiền cọc</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DanhSachDonCoc)
                        {
                            <tr>
                                <td>#@d.MaDonCoc</td>
                                <td><strong>@d.HoTen</strong><br><small class="text-muted">@d.SoDienThoai</small></td>
                                <td>@d.PhienBan?.DongXe?.TenDong<br><small class="text-muted">@d.PhienBan?.TenPhienBan</small></td>
                                <td>@d.SoTienCoc.ToString("N0")đ</td>
                                <td>@d.NgayTaoDon.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @switch (d.TrangThaiDonHang)
                                    {
                                        case "Chờ xác nhận":
                                            <span class="badge badge-waiting">Chờ xác nhận</span>
                                            break;
                                        case "Đã xác nhận":
                                            <span class="badge badge-confirmed">Đã xác nhận</span>
                                            break;
                                        case "Hoàn tất":
                                            <span class="badge badge-completed">Hoàn tất</span>
                                            break;
                                        case "Đã từ chối":
                                            <span class="badge badge-rejected">Đã từ chối</span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge badge-cancelled">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@d.TrangThaiDonHang</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (d.TrangThaiDonHang == "Chờ xác nhận")
                                    {
                                        <form method="post" asp-page-handler="Approve" style="display:inline" onsubmit="return confirm('Chấp nhận đơn cọc #@d.MaDonCoc?');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Chấp nhận</button>
                                        </form>
                                        <form method="post" asp-page-handler="Reject" style="display:inline" onsubmit="return confirm('Từ chối đơn cọc #@d.MaDonCoc? Tiền cọc sẽ được hoàn lại.');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Không chấp nhận</button>
                                        </form>
                                    }
                                    @if (d.TrangThaiDonHang == "Đã xác nhận")
                                    {
                                        <form method="post" asp-page-handler="Sold" style="display:inline" onsubmit="return confirm('Xác nhận bán thành công xe này?');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check-circle"></i> Bán thành công</button>
                                        </form>
                                        <form method="post" asp-page-handler="CancelSale" style="display:inline" onsubmit="return confirm('Hủy bán đơn cọc #@d.MaDonCoc? Tiền cọc sẽ được hoàn lại.');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-warning btn-sm"><i class="fas fa-ban"></i> Hủy bán</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
