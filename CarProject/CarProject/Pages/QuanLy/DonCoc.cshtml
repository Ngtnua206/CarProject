@page
@model CarProject.Pages.QuanLy.DonCocModel
@{
    ViewData["Title"] = "Quản lý đơn cọc";
    Layout = "_Layout";
}

<style>
    .ql-header { background: linear-gradient(135deg, #1a1a2e, #16213e); color: #fff; padding: 2rem 0; margin-bottom: 2rem; }
    .ql-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 1.5rem; }
    .badge-waiting { background: #fef3c7; color: #92400e; }
    .badge-confirmed { background: #d1fae5; color: #065f46; }
    .badge-rejected { background: #fee2e2; color: #991b1b; }
    .badge-completed { background: #e0e7ff; color: #3730a3; }
    .badge-cancelled { background: #f3e8ff; color: #6b21a8; }
</style>

<div class="ql-header">
    <div class="container">
        <h1 style="font-size: 1.5rem; font-weight: 600; margin: 0;">
            <i class="fas fa-file-invoice me-2"></i> Quản lý đơn cọc
        </h1>
        @if (Model.Showroom != null)
        {
            <p class="mb-0 mt-1" style="opacity: 0.7;">Showroom: <strong>@Model.Showroom.TenChiNhanh</strong></p>
        }
    </div>
</div>

<div class="container" style="padding-bottom: 3rem;">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (!Model.DanhSachDonCoc.Any())
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.2;"><i class="fas fa-file-invoice"></i></div>
            <h4 style="color: #333;">Chưa có đơn cọc nào</h4>
        </div>
    }
    else
    {
        <div class="ql-card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th>Tiền cọc</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DanhSachDonCoc)
                        {
                            <tr>
                                <td>#@d.MaDonCoc</td>
                                <td><strong>@d.HoTen</strong><br><small class="text-muted">@d.SoDienThoai</small></td>
                                <td>
                                    @foreach (var ct in d.ChiTiets)
                                    {
                                        var ctTen = $"{ct.PhienBan?.DongXe?.TenDong ?? ""} {ct.PhienBan?.TenPhienBan ?? ""}".Trim();
                                        var isMine = ct.MaChiNhanh == Model.Showroom?.MaChiNhanh;
                                        var tienNhanBadge = ct.TrangThaiTiepNhan switch
                                        {
                                            "Đã tiếp nhận" => "<span class='badge badge-confirmed'>Đã tiếp nhận</span>",
                                            "Từ chối" => $"<span class='badge badge-rejected'>Từ chối</span><br><small class='text-muted'>{(ct.LyDoTuChoi ?? "")}</small>",
                                            _ => "<span class='badge badge-waiting'>Chờ xác nhận</span>"
                                        };
                                        <div style="border:1px solid #eee;border-radius:6px;padding:0.5rem;margin-bottom:0.4rem;">
                                            <div>@ctTen <small class="text-muted">x@(ct.SoLuong)</small> @Html.Raw(tienNhanBadge)</div>
                                            <div style="font-size:0.7rem;color:#999;">Showroom: @(ct.ChiNhanh?.TenChiNhanh ?? ct.MaChiNhanh)@(isMine ? " (của bạn)" : "")</div>
                                            @if (isMine && ct.TrangThaiTiepNhan == "Chờ xác nhận")
                                            {
                                                var isReceive = ct.MaChiNhanh == d.MaChiNhanh;
                                                <div style="margin-top:0.3rem;">
                                                    <form method="post" asp-page-handler="Accept" style="display:inline" onsubmit="return confirm('@(isReceive ? "Tiếp nhận xe này?" : "Đồng ý vận chuyển xe này?")');">
                                                        <input type="hidden" name="maChiTiet" value="@ct.MaChiTiet" />
                                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> @(isReceive ? "Tiếp nhận" : "Đồng ý vận chuyển")</button>
                                                    </form>
                                                    <button type="button" class="btn btn-danger btn-sm" onclick="openRejectModal(@ct.MaChiTiet, '@ctTen.Replace("'", "\\'")', @(isReceive ? "'Không tiếp nhận'" : "'Từ chối vận chuyển'"))">
                                                        <i class="fas fa-times"></i> @(isReceive ? "Không tiếp nhận" : "Từ chối vận chuyển")
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>@d.SoTienCoc.ToString("N0")đ</td>
                                <td>@d.NgayTaoDon.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @switch (d.TrangThaiDonHang)
                                    {
                                        case "Chờ xác nhận":
                                            <span class="badge badge-waiting">Chờ xác nhận</span>
                                            break;
                                        case "Đã xác nhận":
                                            <span class="badge badge-confirmed">Đã xác nhận</span>
                                            break;
                                        case "Hoàn tất":
                                            <span class="badge badge-completed">Hoàn tất</span>
                                            break;
                                        case "Đã từ chối":
                                            <span class="badge badge-rejected">Đã từ chối</span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge badge-cancelled">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@d.TrangThaiDonHang</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && d.TrangThaiDonHang == "Chờ xác nhận" && d.ChiTiets.Any() && d.ChiTiets.All(c => c.TrangThaiTiepNhan == "Đã tiếp nhận"))
                                    {
                                        <form method="post" asp-page-handler="AcceptOrder" onsubmit="return confirm('Tiếp nhận toàn bộ đơn cọc này?');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check"></i> Tiếp nhận đơn cọc</button>
                                        </form>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && d.TrangThaiDonHang == "Đã xác nhận")
                                    {
                                        <form method="post" asp-page-handler="Sold" onsubmit="return confirm('Xác nhận bán xe và tạo hoá đơn?');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-receipt"></i> Bán thành công</button>
                                        </form>
                                    }
                                    @if (d.TrangThaiDonHang == "Hoàn tất")
                                    {
                                        var hd = Model.HoaDonList.FirstOrDefault(h => h.MaDonCoc == d.MaDonCoc);
                                        if (hd != null)
                                        {
                                            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:0.5rem;min-width:220px;">
                                                <div style="font-weight:600;font-size:0.85rem;"><i class="fas fa-file-invoice-dollar"></i> @hd.MaHoaDon</div>
                                                <div style="font-size:0.75rem;color:#475569;">Cơ sở: <strong>@(Model.Showroom?.TenChiNhanh)</strong></div>
                                                <div style="font-size:0.75rem;color:#475569;">Khách: <strong>@d.HoTen</strong> (@d.SoDienThoai)</div>
                                                <div style="font-size:0.75rem;color:#475569;">Tổng: <strong>@hd.TongTienPhaiTra.ToString("N0")đ</strong> · Cọc: @hd.SoTienDaThanhToan.ToString("N0")đ · Còn: <strong>@((hd.TongTienPhaiTra - hd.SoTienDaThanhToan).ToString("N0"))đ</strong></div>
                                            </div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal từ chối tiếp nhận xe -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Reject">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectTitle">Từ chối tiếp nhận xe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="maChiTiet" id="rejectMaChiTiet" />
                    <div class="mb-3">
                        <label class="form-label">Xe</label>
                        <input type="text" class="form-control" id="rejectTenXe" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do từ chối <span style="color:red;">*</span></label>
                        <textarea name="lyDoTuChoi" id="rejectLyDo" class="form-control" rows="3" required placeholder="Bắt buộc nhập lý do từ chối"></textarea>
                        <small class="text-muted">Lý do sẽ được gửi tới Admin và khách hàng.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-times"></i> Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openRejectModal(maChiTiet, tenXe, actionLabel) {
        document.getElementById('rejectMaChiTiet').value = maChiTiet;
        document.getElementById('rejectTenXe').value = tenXe;
        document.getElementById('rejectLyDo').value = '';
        document.getElementById('rejectTitle').textContent = actionLabel || 'Từ chối tiếp nhận xe';
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }
</script>
